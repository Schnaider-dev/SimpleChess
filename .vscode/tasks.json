{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build whole project",
            "command": "cl.exe",
            "args": [
              // Zi requests debug information
              "/Zi",
              // EHsc enables standard C++ exception handling;
              "/EHsc",
              // nologo hides the compiler’s startup banner.
              "/nologo",
              // Fe... only chooses the output executable’s name and location.
              "/Fe${workspaceFolder}\\SimpleChessGame.exe",
              "${workspaceFolder}\\main.cpp",
              "${workspaceFolder}\\Bishop.cpp",
              "${workspaceFolder}\\Board.cpp",
              "${workspaceFolder}\\King.cpp",
              "${workspaceFolder}\\Knight.cpp",
              "${workspaceFolder}\\Pawn.cpp",
              "${workspaceFolder}\\Piece.cpp",
              "${workspaceFolder}\\Player.cpp",
              "${workspaceFolder}\\Position.cpp",
              "${workspaceFolder}\\Queen.cpp",
              "${workspaceFolder}\\Rook.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "version": "2.0.0"
}